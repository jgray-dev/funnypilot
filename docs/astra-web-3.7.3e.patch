+async function fixture(run) {
+  const dbPath = join(temporary, randomUUID() + '.sqlite');
+  let db = new DatabaseSync(dbPath), storage = storageAdapter(db);
+  let now = 1800000000000, browserValid = true;
+  const previousNow = Date.now;
+  Date.now = () => now;
+  let hardware = new LinkedDevices(storage, browser => browser === 'owner-fixture' && browserValid, () => {});
+  const f = {
+    advance: ms => { now += ms; },
+    now: () => now,
+    browser: valid => { browserValid = valid; },
+    sql: (query, ...bindings) => storage.sql.exec(query, ...bindings).toArray(),
+    alarm: async () => { storage.consumeAlarm(); await hardware.alarm(); },
+    alarmTime: () => storage.getAlarm(),
+    reconstruct() { db.close(); db = new DatabaseSync(dbPath); storage = storageAdapter(db); hardware = new LinkedDevices(storage, browser => browser === 'owner-fixture' && browserValid, () => {}); },
+    async call(path, value, auth = {}) {
+      const url = new URL(path, 'https://fixture.invalid');
+      const request = new Request(url, { method: value === undefined ? 'GET' : 'POST', headers: auth.token ? { Authorization: `Bearer ${auth.token}` } : {} });
+      const response = await hardware.handle(url.pathname, request, value || {}, auth.owner ? 'owner-fixture' : undefined);
