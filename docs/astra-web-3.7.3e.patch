+import { join } from 'node:path';
+import { pathToFileURL } from 'node:url';
+
+// Node 24 transforms production TypeScript (including parameter properties).
+// No compiler dependency and no copied production state-machine logic.
+const source = await readFile(new URL('../worker/linked-devices.ts', import.meta.url), 'utf8');
+const temporary = await mkdtemp(join(tmpdir(), 'astra-linked-storage-'));
+const compiledPath = join(temporary, 'linked-devices.mjs');
+await writeFile(compiledPath, stripTypeScriptTypes(source, { mode: 'transform' }));
+const { LinkedDevices } = await import(pathToFileURL(compiledPath).href);
+const code = { branch: 'funnypilot-3.7.3e', commit: 'a'.repeat(40), dirty: false, version: '3.7.3e' };
+const offroad = { mode: 'offroad', reason: 'Synthetic ignition off' };
+const credential = () => randomBytes(32).toString('hex');
+
+// Execute production SQL in actual SQLite. This adapter emulates only the storage
+// API, not linked-device state transitions. Savepoints preserve transaction rollback.
+function storageAdapter(db) {
+  db.exec('CREATE TABLE IF NOT EXISTS fixture_alarm (id INTEGER PRIMARY KEY CHECK (id=1), time INTEGER NOT NULL)');
+  let transaction = 0;
+  return {
+    sql: { exec(query, ...bindings) {
+      const statement = db.prepare(query);
+      const rows = statement.all(...bindings).map(row => ({ ...row }));
+      return { toArray: () => rows, one: () => { assert.equal(rows.length, 1); return rows[0]; }, [Symbol.iterator]: () => rows[Symbol.iterator]() };
+    } },
+    transactionSync(fn) {
+      const name = `fixture_${++transaction}`; db.exec(`SAVEPOINT ${name}`);
+      try { const result = fn(); db.exec(`RELEASE ${name}`); return result; }
+      catch (error) { db.exec(`ROLLBACK TO ${name}`); db.exec(`RELEASE ${name}`); throw error; }
+    },
+    async getAlarm() { return db.prepare('SELECT time FROM fixture_alarm WHERE id=1').get()?.time ?? null; },
+    async setAlarm(time) { db.prepare('INSERT OR REPLACE INTO fixture_alarm VALUES(1,?)').run(time); },
+    consumeAlarm() { db.exec('DELETE FROM fixture_alarm'); },
+  };
+}
