@@ -0,0 +1,24 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createFeedbackClient, feedbackDirectory } from '../server/feedback-tools.mjs';
+
+test('feedback uses host account tools with separate argv and no vehicle connection', async () => {
+  const calls = [];
+  const client = createFeedbackClient({ run: async (file, args, options) => { calls.push({ file, args, options }); return { stdout: args[1] === 'list' ? '[]' : 'done' }; } });
+  assert.deepEqual((await client.feedback_list({ status: 'new' })).reports, []);
+  const id = 'a'.repeat(32);
+  const downloaded = await client.feedback_download({ id });
+  assert.equal(downloaded.directory, `${feedbackDirectory}/${id}`);
+  const note = 'Measured torque; $(do not execute) `literal`';
+  await client.feedback_review({ id, status: 'triaged', note });
+  assert.equal(calls[2].args[calls[2].args.indexOf('--note') + 1], note);
+  assert.ok(calls.every(c => c.file === '/usr/bin/python3' && c.options.cwd === '/home/astro/Development/c3x'));
+  await assert.rejects(client.feedback_download({ id: '../private' }), /Invalid/);
+  await assert.rejects(client.feedback_review({ id, status: 'fixed', note }), /actual fix commit/);
+  assert.equal(calls.length, 3);
+});
+
+test('account failure does not expose raw subprocess error or credentials', async () => {
+  const client = createFeedbackClient({ run: async () => { throw Error('token=private'); } });
+  await assert.rejects(client.feedback_list(), error => /Wrangler account access/.test(error.message) && !error.message.includes('token=private'));
+});
