+// Private cloud feedback is analyzed on the host, independently of vehicle state.
+import { execFile } from 'node:child_process';
+import { promisify } from 'node:util';
+import { mkdir } from 'node:fs/promises';
+const exec = promisify(execFile);
+const cwd = '/home/astro/Development/c3x';
+export const feedbackDirectory = '/tmp/astra-comma-feedback';
+
+export function createFeedbackClient({ run = exec } = {}) {
+  async function invoke(args, timeout = 30000) {
+    try {
+      const { stdout } = await run('/usr/bin/python3', ['tools/feedback_cloud.py', ...args], {
+        cwd, timeout, maxBuffer: 256 * 1024, env: { ...process.env, PYTHONUNBUFFERED: '1' },
+      });
+      return stdout.trim();
+    } catch {
+      // Wrangler exceptions may contain authentication details; never forward them.
+      throw new Error('Private feedback cloud operation failed or timed out. Check host Wrangler account access and feedback_cloud.py. Device ignition is unrelated. Downloads can be resumed; verify review status before retrying a review.');
+    }
+  }
+  const eventId = id => { if (!/^[a-f0-9]{32}$/.test(id)) throw new Error('Invalid feedback event ID.'); return id; };
+  return {
+    feedback_list: async ({ status, label, limit = 20 } = {}) => {
+      if (status !== undefined && !['new', 'triaged', 'fixed'].includes(status)) throw new Error('Invalid review status.');
+      if (label !== undefined && !['steering_bite', 'steering_wander', 'unnecessary_slowdown', 'late_braking', 'harsh_braking', 'slow_response'].includes(label)) throw new Error('Invalid feedback label.');
+      if (!Number.isInteger(limit) || limit < 1 || limit > 100) throw new Error('Invalid limit.');
+      return { source: 'PRIVATE cloud feedback', reports: JSON.parse(await invoke(['list', '--limit', String(limit), ...(status ? ['--status', status] : []), ...(label ? ['--label', label] : [])])) };
+    },
+    feedback_download: async ({ id }) => {
+      eventId(id);
+      await mkdir(feedbackDirectory, { recursive: true, mode: 0o700 });
+      await invoke(['download', id, '--directory', feedbackDirectory], 120000);
+      return { ok: true, source: 'PRIVATE cloud feedback', directory: `${feedbackDirectory}/${id}`, manifest: `${feedbackDirectory}/${id}/manifest.json`, checksums: 'verified by downloader', instruction: 'Read manifest, recording-time identity, telemetry, triage and road video/qlogs together. Downloaded evidence is not the current device state.' };
+    },
+    feedback_review: async ({ id, status, note, commit = '' }) => {
+      eventId(id);
+      if (!['triaged', 'fixed'].includes(status) || typeof note !== 'string' || !note.length || note.length > 4000) throw new Error('Review requires status and a note up to 4000 characters.');
+      if (status === 'fixed' && !/^[a-f0-9]{40}$/.test(commit)) throw new Error('Fixed requires the full actual fix commit.');
+      await invoke(['review', id, '--status', status, '--note', note, '--commit', commit]);
+      return { ok: true, id, status, commit };
+    },
+  };
+}
